# Copiez ce fichier en ".env.local" et remplissez les valeurs

# Supabase — Project Settings > API dans votre dashboard Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Clé service_role — Project Settings > API > service_role secret
# ⚠️ SECRÈTE : ne jamais préfixer par NEXT_PUBLIC_, ne jamais exposer au navigateur.
# Nécessaire pour créer les commandes/billets côté serveur (routes /api/checkout, /api/confirm-payment)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# GeniusPay — à créer sur https://onboarding.geniuspay.ci (compte marchand + clés sandbox/prod)
GENIUSPAY_API_KEY=your_geniuspay_api_key_here
GENIUSPAY_API_SECRET=your_geniuspay_api_secret_here
GENIUSPAY_WEBHOOK_SECRET=your_geniuspay_webhook_secret_here
NEXT_PUBLIC_GENIUSPAY_PUBLIC_KEY=your_geniuspay_public_key_here
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# À ne décommenter que après avoir vérifié l'endpoint API avec GeniusPay support
# GENIUSPAY_ENDPOINT_VERIFIED=true
